# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git -- only this example file.

# Optional: increases PubMed's rate limit if provided
PUBMED_API_KEY=

# Optional: NIH API key, if the specific NIH endpoint you use requires one
NIH_API_KEY=

# Required: Atlas's ingestion API endpoint
ATLAS_API_URL=http://localhost:8000/api/ingest

# Required: API key/token to authenticate with Atlas's ingestion API
ATLAS_API_KEY=
